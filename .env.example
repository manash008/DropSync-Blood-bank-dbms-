PORT=5000
FRONTEND_URL=http://localhost:5000

# MySQL 8.0.19+; leave DB_PASSWORD blank only if your local MySQL account has no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bloodbank_sql
DB_USER=root
DB_PASSWORD=

# Optional. Leave blank to run SQL search without MongoDB activity logging.
MONGO_URI=mongodb://127.0.0.1:27017/bloodbank_nosql
